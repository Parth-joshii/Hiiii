# Production database settings
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=portfolio
MONGODB_COLLECTION=inquiries

# Optional: backend port for local API server
INQUIRY_PORT=8787

# Frontend build setting. Use only if the API is hosted on a different domain.
# Example: VITE_INQUIRY_API_BASE_URL=https://your-api.onrender.com
VITE_INQUIRY_API_BASE_URL=
